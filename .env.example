# Firebase Configuration
FIREBASE_API_KEY=your_api_key_here
FIREBASE_AUTH_DOMAIN=your_auth_domain_here
FIREBASE_PROJECT_ID=your_project_id_here
FIREBASE_STORAGE_BUCKET=your_storage_bucket_here
FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
FIREBASE_APP_ID=your_app_id_here
FIREBASE_DATABASE_URL=https://dashboard-app-5058e-default-rtdb.firebaseio.com

# Server Configuration
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# JWT Secret (for session management)
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# Rate Limiting
RATE_LIMIT_WINDOW_MS=15000
RATE_LIMIT_MAX_REQUESTS=100

# ===========================
# USSD & TRANSFER SETTINGS
# ===========================

# USSD Provider (airtel, tnm, vodacom)
USSD_PROVIDER=airtel

# Airtel USSD Configuration
AIRTEL_USSD_CODE=*165#
AIRTEL_API_KEY=your_airtel_api_key
AIRTEL_API_URL=https://api.airtel.co.mw

# TNM USSD Configuration
TNM_USSD_CODE=*174#
TNM_API_KEY=your_tnm_api_key
TNM_API_URL=https://api.tnm.mw

# Vodacom USSD Configuration
VODACOM_USSD_CODE=*123#
VODACOM_API_KEY=your_vodacom_api_key
VODACOM_API_URL=https://api.vodacom.mw

# ===========================
# TRANSFER ACCOUNT SETTINGS
# ===========================

# Designated account for savings transfers
TRANSFER_ACCOUNT_NAME=My Savings Account
TRANSFER_ACCOUNT_NUMBER=0123456789
TRANSFER_ACCOUNT_NETWORK=airtel
TRANSFER_ACCOUNT_PHONE=+265123456789

# Minimum amount to trigger auto-transfer (in MK)
MIN_TRANSFER_AMOUNT=100

# Maximum amount per transaction (in MK)
MAX_TRANSFER_AMOUNT=50000

# Enable automatic transfers (true/false)
AUTO_TRANSFER_ENABLED=true

# Transfer frequency (immediate, daily, weekly, monthly)
TRANSFER_FREQUENCY=immediate

# ===========================
# SMS GATEWAY (for USSD simulation)
# ===========================

# SMS Gateway Provider (twilio, africastalking, custom)
SMS_GATEWAY_PROVIDER=custom
SMS_GATEWAY_API_URL=https://your-sms-gateway.com/api
SMS_GATEWAY_API_KEY=your_sms_gateway_key

# ===========================
# WEBHOOK SECRETS
# ===========================

# Macrodroid webhook secret
MACRODROID_WEBHOOK_SECRET=your_macrodroid_secret

# Transfer notification webhook
TRANSFER_WEBHOOK_URL=https://your-callback-url.com/webhook
